# Copy to .env and fill in. This file never leaves your computer; the browser never sees it.
SESSION_SECRET=           # python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=conflux.db
LLM_API_KEY=              # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash   # check Google's current model list if this is rejected
WEB_SEARCH_API_KEY=       # free tier: https://app.tavily.com
MOCK_WEB_SEARCH=true      # set false once WEB_SEARCH_API_KEY is filled
DOCUMENT_ONLY=false       # true disables web search completely

# Private Work. Mock mode prints instead of contacting anyone; set false only when the credentials below are filled.
MOCK_EMAIL=true
EMAIL_ADDRESS=            # your Gmail address
EMAIL_APP_PASSWORD=       # Google Account > Security > 2-Step Verification > App passwords (16 characters)
MOCK_PHONE=true
PHONE_PROVIDER=infobip    # infobip (free trial, spoken text), sinch, or twilio (custom messages need a paid account)
INFOBIP_API_KEY=          # Infobip portal > Developers > API keys (needs the voice:message:message:send scope)
INFOBIP_BASE_URL=         # your own API address from the portal, like xxxxx.api.infobip.com
INFOBIP_FROM=             # digits only; copy the "from" value shown in the portal's ready-made voice API request
INFOBIP_LANGUAGE=en
SINCH_APPLICATION_KEY=    # Sinch Dashboard > Voice > Apps
SINCH_APPLICATION_SECRET=
SINCH_CLI=                # caller ID: your number verified in Sinch, or your Sinch dashboard number, e.g. +919876543210
TWILIO_SID=               # Twilio: custom spoken messages need an upgraded (paid) account; trial accounts reject them
TWILIO_TOKEN=
TWILIO_FROM=              # your Twilio number, e.g. +15551234567
